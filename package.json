{
  "name": "lichtrinh",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "bin": {
    "lichtrinh": "cli/index.ts"
  },
  "scripts": {
    "dev": "WORKTREE_PORT_OFFSET=$(bash scripts/worktree-port.sh) && export WORKTREE_PORT_OFFSET && vite",
    "build": "tsc --noEmit && vite build",
    "lint": "oxlint --max-warnings 0",
    "preview": "WORKTREE_PORT_OFFSET=$(bash scripts/worktree-port.sh) && export WORKTREE_PORT_OFFSET && vite preview",
    "prepare": "husky",
    "check": "bun scripts/verify.ts && cd voice && VERIFY_NESTED=true bun scripts/verify.ts",
    "check:format": "oxfmt --check .",
    "format": "oxfmt .",
    "typecheck": "bun run types:worker && tsc --noEmit && tsc --noEmit -p worker/tsconfig.json",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "types:worker": "wrangler types worker/worker-configuration.d.ts",
    "test": "vitest",
    "test:run": "vitest run --reporter=verbose",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "WORKTREE_PORT_OFFSET=$(bash scripts/worktree-port.sh) && export WORKTREE_PORT_OFFSET && playwright test",
    "test:e2e:changed": "WORKTREE_PORT_OFFSET=$(bash scripts/worktree-port.sh) && export WORKTREE_PORT_OFFSET && playwright test --only-changed",
    "test:e2e:ui": "WORKTREE_PORT_OFFSET=$(bash scripts/worktree-port.sh) && export WORKTREE_PORT_OFFSET && playwright test --ui",
    "test:e2e:report": "playwright show-report",
    "check:full": "bun scripts/verify.ts && bun run test:e2e",
    "smoke:prod": "bun e2e/screenshot.ts --check-console-clean --require-base-url",
    "lint:fix": "oxlint --fix --max-warnings 0",
    "screenshot": "PREVIEW_PORT=$(bash scripts/worktree-port.sh 4173) && export PREVIEW_PORT && LICHTRINH_STATE_ROOT=$(mktemp -d) && export LICHTRINH_STATE_ROOT && bun scripts/seed.ts && bash scripts/screenshot.sh",
    "design:sync": "bash scripts/design-sync.sh",
    "readme-screenshot": "PREVIEW_PORT=$(bash scripts/worktree-port.sh 4173) && export PREVIEW_PORT && bash scripts/readme-screenshot.sh"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.2",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.19",
    "i18next": "^27.2.3",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^18.0.3",
    "react-router": "^8.5.2",
    "shadcn": "^4.23.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@cloudflare/vitest-plugin": "^1.9.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "^1.65.1",
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5",
    "@vitest/ui": "^5",
    "commander": "^15.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint-plugin-check-file": "^3.3.2",
    "eslint-plugin-simple-import-sort": "^14.0.0",
    "husky": "^9.1.7",
    "jsdom": "^31.0.1",
    "oxfmt": "0.72.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5",
    "wrangler": "^4.166.0"
  }
}
