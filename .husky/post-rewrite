#!/usr/bin/env sh

# `git pull` under `pull.rebase=true` fires this event and never `post-merge`.
# `commit --amend` fires it too, so only the `rebase` argument delegates.

[ "$1" = "rebase" ] || exit 0

hook="$(dirname "$0")/post-merge"
[ -f "$hook" ] || exit 0

# shellcheck source=/dev/null
. "$hook"
